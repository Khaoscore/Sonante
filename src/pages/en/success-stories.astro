---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CasosHero from "@/components/casos/CasosHero";
import CaseSection from "@/components/casos/CaseSection";
import StatsBand from "@/components/casos/StatsBand";
import Testimonials from "@/components/casos/Testimonials";
import BigStats from "@/components/casos/BigStats";
import { casosContent } from "@/data/casos";

const lang = "en";
const { meta, casos } = casosContent[lang];
---

<BaseLayout title={meta.title} description={meta.description} lang={lang}>
  <CasosHero client:load lang={lang} />
  {casos.map((caso) => <CaseSection client:visible={{ rootMargin: "400px" }} caso={caso} lang={lang} />)}
  <StatsBand lang={lang} />
  <Testimonials client:visible lang={lang} />
  <BigStats lang={lang} />
</BaseLayout>
