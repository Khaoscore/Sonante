# Endpoint opcional para el formulario de contacto (Formspree, Getform, n8n webhook, etc.).
# Si se deja vacío, el formulario abre el cliente de correo con el mensaje prellenado.
PUBLIC_FORM_ENDPOINT=

# Publicaciones de Instagram del muro de "Nuestros tips" (npm run social). Basta una
# de las dos fuentes. En producción van como secretos de GitHub Actions; ver README,
# sección "Publicaciones de Instagram en Nuestros tips".
BEHOLD_FEED_URL=
INSTAGRAM_TOKEN=
# Solo para convertir un token de Meta de 1 hora en uno de 60 días (npm run social -- --exchange)
INSTAGRAM_APP_SECRET=
