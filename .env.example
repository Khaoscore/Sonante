# Formulario de contacto: URL /exec del Apps Script (apps-script/formulario-contacto/LEEME.md).
# Obligatoria: sin ella el formulario no envía. En producción va en Vercel (Settings → Environment Variables).
FORM_ENDPOINT=
# Opcional: site key de Cloudflare Turnstile (el secreto va en las propiedades del Apps Script).
PUBLIC_TURNSTILE_SITE_KEY=

# Publicaciones de Instagram del muro de "Nuestros tips" (npm run social). Basta una
# de las dos fuentes. En producción van como secretos de GitHub Actions; ver README,
# sección "Publicaciones de Instagram en Nuestros tips".
BEHOLD_FEED_URL=
INSTAGRAM_TOKEN=
# Solo para convertir un token de Meta de 1 hora en uno de 60 días (npm run social -- --exchange)
INSTAGRAM_APP_SECRET=
